# ---- CHES_Artifact/curve25519 Makefile ----
# The complete X25519 programs of the Curve25519 case study:
#   full_curve25519_inline2    SETCC carries     (fe_mul 58 + fe_sq 41 triads)
#   full_curve25519_adc_mod2   ADD|MOD2 carries  (fe_mul 45 + fe_sq 31 triads)
# The paper's two Curve25519 rows are inline2 (SETCC) and adc_mod2 (ADD|MOD2).
# Trimmed from simple/curve25519/Makefile to these programs; the rules
# below are that Makefile's, with the third-party paths moved to third_party/.
# The benchmark harness behind the paper's tables is Benchmarks/ (own Makefile).
#
# Paths: libmicro.a and its headers through $(LIBMICRO), the SUPERCOP,
# s2n-bignum and fiat-crypto sources in third_party/, the namespace headers in
# include/. The shared patch.h/ucode_macro.h/misc.h come from lib-micro's
# include/ via -I, so the sources include them as <patch.h>.
#
# The LIBMICRO default is the pinned submodule at the top of this repository;
# override it for any other location:  make LIBMICRO=/path/to/lib-micro PROG=...
#
# Build: make PROG=full_curve25519_inline2      (or PROG=full_curve25519_adc_mod2)
# Run:   sudo wrmsr -p 1 0x1e6 0x200            (debug unlock, core 1)
#        sudo taskset -c 1 ./full_curve25519_inline2_static
#        sudo taskset -c 1 ./full_curve25519_inline2_static verify
LIBMICRO ?= ../lib-micro

CC      := gcc
NASM    := nasm
LDFLAGS := -static
LIBS    := $(LIBMICRO)/build/libmicro.a

PROG ?= full_curve25519_inline2

# ---- default target ----
all: $(PROG)_static

# ---- Match SUPERCOP's compiler flags for full_curve25519 fairness ----
# SUPERCOP tries: gcc -march=native -mtune=native -O{3,2,Os,O} -fwrapv -fPIC -fPIE -gdwarf-4 -Wall
# We use the -O3 variant. Derived flag vars (AMD51_CFLAGS, ...) inherit it.
CFLAGS := -O3 -fwrapv -fPIC -fPIE -gdwarf-4 -Wall -masm=intel -march=native -mtune=native -I include/ -I$(LIBMICRO)/include

# ---- SUPERCOP amd64-51 X25519 ----
AMD51_DIR  := third_party/supercop-20260330/crypto_scalarmult/curve25519/amd64-51
SC_INC     := third_party/supercop-data/include
SC_LIB     := third_party/supercop-data/lib
AMD51_CPP  := -I$(AMD51_DIR) -I$(SC_INC) -include include/amd64_51_namespace.h
# amd64-51 + supercop crypto_int64.h use AT&T inline asm; override -masm=intel.
AMD51_CFLAGS := $(filter-out -masm=intel,$(CFLAGS)) -masm=att

AMD51_OBJS := \
    amd64-51_mont25519.o \
    amd64-51_consts.o \
    amd64-51_fe25519_invert.o \
    amd64-51_fe25519_pack.o \
    amd64-51_fe25519_setint.o \
    amd64-51_fe25519_unpack.o \
    amd64-51_fe25519_freeze.o \
    amd64-51_fe25519_mul.o \
    amd64-51_fe25519_square.o \
    amd64-51_ladderstep.o \
    amd64-51_work_cswap.o

amd64-51_%.o: $(AMD51_DIR)/%.c
	$(CC) $(AMD51_CFLAGS) $(AMD51_CPP) -c $< -o $@

amd64-51_%.o: $(AMD51_DIR)/%.S
	$(CC) $(AMD51_CFLAGS) $(AMD51_CPP) -c $< -o $@

# ---- SUPERCOP amd64-64 X25519 ----
# Same Bernstein/Schwabe authors as amd64-51 but uses 4x64-bit saturated
# limbs (radix 2^64) instead of 5x51 unsaturated. lib25519's autotuner
# selects this on Goldmont (~22% faster than amd64-51 there).
AMD64_DIR  := third_party/supercop-20260330/crypto_scalarmult/curve25519/amd64-64
AMD64_CPP  := -I$(AMD64_DIR) -I$(SC_INC) -include include/amd64_64_namespace.h
AMD64_CFLAGS := $(filter-out -masm=intel,$(CFLAGS)) -masm=att

AMD64_OBJS := \
    amd64-64_mont25519.o \
    amd64-64_consts.o \
    amd64-64_fe25519_invert.o \
    amd64-64_fe25519_pack.o \
    amd64-64_fe25519_setint.o \
    amd64-64_fe25519_unpack.o \
    amd64-64_fe25519_freeze.o \
    amd64-64_fe25519_mul.o \
    amd64-64_fe25519_square.o \
    amd64-64_ladderstep.o \
    amd64-64_work_cswap.o

amd64-64_%.o: $(AMD64_DIR)/%.c
	$(CC) $(AMD64_CFLAGS) $(AMD64_CPP) -c $< -o $@

amd64-64_%.o: $(AMD64_DIR)/%.S
	$(CC) $(AMD64_CFLAGS) $(AMD64_CPP) -c $< -o $@

# ---- CryptOpt fe_mul / fe_sq (Goldmont-tuned, generated by CryptOpt) ----
# The .asm files declare `fiat_curve25519_carry_{mul,square}` which clashes
# with the fiat-crypto C version already linked. Sed-rename to `cryptopt_*`
# at assemble time so both backends coexist as separate benchmark contenders.
# Some `mul [mem]` lines lack explicit size - newer NASM requires `qword`.
# Sed appends qword where needed, in the same pass as the GLOBAL rename.
cryptopt_mul.o: cryptopt_mul.asm
	sed -e 's/fiat_curve25519_carry_mul/cryptopt_carry_mul/g' \
	    -e 's/^mul \[/mul qword [/' $< > $@.tmp.asm
	$(NASM) -f elf64 -o $@ $@.tmp.asm
	rm -f $@.tmp.asm
cryptopt_sq.o: cryptopt_sq.asm
	sed -e 's/fiat_curve25519_carry_square/cryptopt_carry_square/g' \
	    -e 's/^mul \[/mul qword [/' $< > $@.tmp.asm
	$(NASM) -f elf64 -o $@ $@.tmp.asm
	rm -f $@.tmp.asm

# OpenSSL fe51 assembly, generated from the shipped perlasm. This build emits
# the fe51 path only; the fe64 entry points become ud2 stubs because they need
# ADX, which the N3350 lacks, so OpenSSL selects fe51 on this core regardless.
# openssl_x25519.o (its C ladder) is built from openssl_x25519.c by make's
# built-in %.o: %.c rule, with $(CFLAGS).
openssl_x25519_asm.o: openssl_x25519_asm.s
	$(CC) -c $< -o $@

# s2n-bignum verified assembly. Only the _alt variants are usable here: the
# base bignum_*_p25519 use MULX/ADCX/ADOX and fault on Goldmont.
S2NB_DIR := third_party/supercop-20260330/s2n-bignum
s2n_x25519_alt.o: $(S2NB_DIR)/x86/curve25519/curve25519_x25519_alt.S
	$(CC) -I$(S2NB_DIR)/include -c $< -o $@

# Both programs host the same contenders, so they link the same objects:
# amd64-51 asm, amd64-64 asm, CryptOpt asm, s2n-bignum and OpenSSL.
EXTRA_OBJS := $(AMD51_OBJS) \
              $(AMD64_OBJS) cryptopt_mul.o cryptopt_sq.o s2n_x25519_alt.o \
              openssl_x25519_asm.o openssl_x25519.o
EXTRA_LIBS := $(SC_LIB)/libcryptoint.a

# Build $(PROG)_static from $(PROG).c (+ the extra objs/libs).
# EXTRA_CPPFLAGS is how patch variants are selected (see the program sources).
$(PROG)_static: $(PROG).c $(LIBS) $(EXTRA_OBJS)
	$(CC) $(LDFLAGS) $(CFLAGS) -I. $(EXTRA_CPPFLAGS) $< $(EXTRA_OBJS) $(LIBS) $(EXTRA_LIBS) -o $@

clean:
	rm -f *_static *.o

.PHONY: all clean
